# Port the Express backend listens on
PORT=4000

# Path/name of the webcmd binary if it is not on your PATH as "webcmd"
# (leave unset if `webcmd --help` already works in your terminal)
WEBCMD_BIN=webcmd

# Timeout (ms) for each `webcmd web fetch` call
WEBCMD_FETCH_TIMEOUT_MS=20000

# Only set this if `webcmd web fetch --url <url> -f json` on your installed
# version returns the fetched page body under a field name OTHER than one of:
# content, markdown, text, response, value, html, body
# WEBCMD_FETCH_CONTENT_FIELD=content
